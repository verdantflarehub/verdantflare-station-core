{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "station://contracts/v1/app-state-notification",
  "x-key-prefix": "/station/app-state-notifications/v1/",
  "$ref": "#/$defs/notification",
  "$defs": {
    "notification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "revision",
        "changedAt"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9:._-]+$"
        },
        "changedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "revision"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "revision": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9:._-]*$"
        }
      }
    }
  }
}
