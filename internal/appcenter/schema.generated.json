{
  "station://contracts/appcenter-v1/command-core": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "station://contracts/appcenter-v1/command-core",
    "title": "command-core",
    "type": "object",
    "properties": {
      "schemaVersion": {
        "const": 1
      },
      "command": {
        "$ref": "station://contracts/v1/app-command",
        "properties": {
          "request_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[^\u0000- ]+$"
          },
          "idempotency_key": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "pattern": "^[^\u0000- ]+$"
          },
          "organization_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "station_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "app_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          },
          "app_version": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "action": {
            "enum": [
              "install",
              "start",
              "stop",
              "restart",
              "delete"
            ]
          }
        }
      },
      "expected": {
        "type": "object",
        "properties": {
          "installationId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "installationRevision": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "appVersion": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "releaseDigest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "workloadUID": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "policyRevision": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        },
        "required": [
          "installationId",
          "installationRevision",
          "appVersion",
          "releaseDigest",
          "workloadUID",
          "policyRevision"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "schemaVersion",
      "command",
      "expected"
    ],
    "additionalProperties": false
  },
  "station://contracts/appcenter-v1/command-registry": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "station://contracts/appcenter-v1/command-registry",
    "title": "command-registry",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schemaVersion",
      "enabled",
      "releases"
    ],
    "properties": {
      "schemaVersion": {
        "const": 1
      },
      "enabled": {
        "type": "boolean"
      },
      "releases": {
        "type": "array",
        "maxItems": 128,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "appId",
            "appVersion",
            "releaseKind",
            "releaseRef",
            "actions"
          ],
          "properties": {
            "appId": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
            },
            "appVersion": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
            },
            "releaseKind": {
              "enum": [
                "signed-package",
                "management-release",
                "dashboard-release"
              ]
            },
            "releaseRef": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"
            },
            "actions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 5,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "install",
                  "start",
                  "stop",
                  "restart",
                  "delete"
                ]
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "releaseKind": {
                    "const": "dashboard-release"
                  }
                }
              },
              "then": {
                "properties": {
                  "actions": {
                    "items": {
                      "enum": [
                        "install",
                        "start",
                        "stop",
                        "restart",
                        "delete"
                      ]
                    }
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "station://contracts/appcenter-v1/common": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "station://contracts/appcenter-v1/common",
    "title": "AppCenterCommon",
    "$defs": {
      "scope": {
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "organizationId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "stationId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "authorizationEpoch": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "userId",
          "organizationId",
          "stationId",
          "authorizationEpoch"
        ],
        "additionalProperties": false
      },
      "source": {
        "type": "object",
        "properties": {
          "source": {
            "enum": [
              "catalog",
              "installations",
              "observations",
              "operations",
              "presentation",
              "entries"
            ]
          },
          "quality": {
            "enum": [
              "known",
              "unknown",
              "unavailable",
              "conflict"
            ]
          },
          "revision": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "observedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              {
                "type": "null"
              }
            ]
          },
          "reasonCode": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]{0,127}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "source",
          "quality",
          "revision",
          "observedAt",
          "reasonCode"
        ],
        "additionalProperties": false
      },
      "installation": {
        "type": "object",
        "properties": {
          "installationId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "appVersion": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "state": {
            "enum": [
              "pending",
              "installed",
              "failed",
              "removed"
            ]
          },
          "lastOperationId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "installationId",
          "revision",
          "appVersion",
          "state",
          "lastOperationId"
        ],
        "additionalProperties": false
      },
      "service": {
        "type": "object",
        "properties": {
          "quality": {
            "enum": [
              "known",
              "unknown",
              "unavailable",
              "conflict"
            ]
          },
          "state": {
            "enum": [
              "absent",
              "ready",
              "stopped",
              "starting",
              "stopping",
              "degraded",
              "unknown"
            ]
          },
          "observedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              {
                "type": "null"
              }
            ]
          },
          "reasonCode": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]{0,127}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "observationKey": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^obs:[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "quality",
          "state",
          "observedAt",
          "reasonCode",
          "observationKey"
        ],
        "additionalProperties": false
      },
      "operation": {
        "type": "object",
        "properties": {
          "quality": {
            "enum": [
              "known",
              "unknown",
              "unavailable",
              "conflict"
            ]
          },
          "blocking": {
            "type": "boolean"
          },
          "operationId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "protocol": {
            "enum": [
              "lifecycle",
              "transition",
              null
            ]
          },
          "status": {
            "enum": [
              "accepted",
              "running",
              "succeeded",
              "failed",
              "recovery_required",
              null
            ]
          },
          "phase": {
            "enum": [
              "accepted",
              "checking",
              "downloading",
              "verifying",
              "installing",
              "starting",
              "warming",
              "stopping",
              "deleting",
              "completed",
              "sealing",
              "applying",
              "publishing",
              "releasing",
              "restoring",
              "recovery_required",
              null
            ]
          },
          "canRead": {
            "type": "boolean"
          },
          "updatedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "Z$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "quality",
          "blocking",
          "operationId",
          "protocol",
          "status",
          "phase",
          "canRead",
          "updatedAt"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "canRead": {
                  "const": false
                }
              }
            },
            "then": {
              "properties": {
                "operationId": {
                  "type": "null"
                },
                "protocol": {
                  "type": "null"
                },
                "status": {
                  "type": "null"
                },
                "phase": {
                  "type": "null"
                },
                "updatedAt": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "canRead": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "operationId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "protocol": {
                  "enum": [
                    "lifecycle",
                    "transition"
                  ]
                },
                "status": {
                  "type": "string"
                },
                "phase": {
                  "type": "string"
                },
                "updatedAt": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "Z$"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "protocol": {
                  "const": "lifecycle"
                }
              }
            },
            "then": {
              "properties": {
                "phase": {
                  "enum": [
                    "checking",
                    "downloading",
                    "verifying",
                    "installing",
                    "starting",
                    "warming",
                    "stopping",
                    "deleting",
                    "completed"
                  ]
                },
                "status": {
                  "enum": [
                    "accepted",
                    "running",
                    "succeeded",
                    "failed"
                  ]
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "protocol": {
                  "const": "transition"
                }
              }
            },
            "then": {
              "properties": {
                "phase": {
                  "enum": [
                    "accepted",
                    "checking",
                    "sealing",
                    "applying",
                    "verifying",
                    "publishing",
                    "releasing",
                    "restoring",
                    "recovery_required",
                    "completed"
                  ]
                },
                "status": {
                  "enum": [
                    "accepted",
                    "running",
                    "succeeded",
                    "failed",
                    "recovery_required"
                  ]
                }
              }
            }
          }
        ]
      },
      "action": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
          },
          "kind": {
            "enum": [
              "open",
              "detail",
              "install",
              "start",
              "stop",
              "restart",
              "delete",
              "progress",
              "refresh"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "reasonCode": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]{0,127}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "entryId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "confirmation": {
            "enum": [
              "none",
              "service-stop",
              "service-restart",
              "installation-delete"
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "enabled",
          "reasonCode",
          "entryId",
          "confirmation"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "enabled": {
                  "const": false
                }
              }
            },
            "then": {
              "properties": {
                "reasonCode": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      },
      "entry": {
        "type": "object",
        "properties": {
          "entryId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
          },
          "transport": {
            "enum": [
              "dashboard",
              "legacy"
            ]
          },
          "quality": {
            "enum": [
              "known",
              "unknown",
              "unavailable",
              "conflict"
            ]
          },
          "availability": {
            "enum": [
              "available",
              "unavailable",
              "denied",
              "incompatible"
            ]
          },
          "reasonCode": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]{0,127}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "requiresServiceReady": {
            "type": "boolean"
          },
          "minimumHostVersion": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "entryId",
          "transport",
          "quality",
          "availability",
          "reasonCode",
          "requiresServiceReady",
          "minimumHostVersion"
        ],
        "additionalProperties": false
      },
      "display": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          },
          "groupId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
          },
          "publisherId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "iconRef": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "resourceTags": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "cpu",
                    "gpu",
                    "models"
                  ]
                },
                "value": {
                  "type": "number",
                  "minimum": 0
                },
                "unit": {
                  "type": "string",
                  "maxLength": 32
                },
                "sourceRef": {
                  "type": "string",
                  "maxLength": 256
                }
              },
              "required": [
                "kind",
                "value",
                "unit",
                "sourceRef"
              ],
              "additionalProperties": false
            },
            "maxItems": 16
          },
          "quality": {
            "enum": [
              "known",
              "unknown",
              "unavailable",
              "conflict"
            ]
          },
          "models": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\s\u0000-\u001f](?:[^\u0000-\u001f]*[^\\s\u0000-\u001f])?$"
            }
          },
          "capabilities": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[^\\s\u0000-\u001f](?:[^\u0000-\u001f]*[^\\s\u0000-\u001f])?$"
            }
          }
        },
        "required": [
          "name",
          "description",
          "groupId",
          "publisherId",
          "iconRef",
          "resourceTags",
          "quality"
        ],
        "additionalProperties": false
      },
      "candidate": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "install",
              "start",
              "stop",
              "restart",
              "delete",
              "adopt"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "reasonCode": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_]{0,127}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "appVersion": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "releaseDigest": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "expectedWorkloadUID": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "kind",
          "enabled",
          "reasonCode",
          "appVersion",
          "releaseDigest",
          "expectedWorkloadUID"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "enabled": {
                  "const": false
                }
              }
            },
            "then": {
              "properties": {
                "reasonCode": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "enabled": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "releaseDigest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              }
            }
          }
        ]
      },
      "group": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
