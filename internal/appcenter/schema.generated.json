  "station://contracts/appcenter-v1/dashboard-release-registry": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "station://contracts/appcenter-v1/dashboard-release-registry",
    "title": "dashboard-release-registry",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schemaVersion",
      "releases"
    ],
    "properties": {
      "schemaVersion": {
        "const": 1
      },
      "releases": {
        "type": "array",
        "maxItems": 128,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "appId",
            "appVersion",
            "releaseRef",
            "releaseIndexRef",
            "manifestRef",
            "releaseDigest",
            "manifestDigest",
            "templateDigest"
          ],
          "properties": {
            "appId": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
            },
            "appVersion": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
            },
            "releaseRef": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,62}$"
            },
            "releaseIndexRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[^\\\\:]+$"
            },
            "manifestRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[^\\\\:]+$"
            },
            "releaseDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "manifestDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "templateDigest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        }
      }
    }
  },
  "station://contracts/appcenter-v1/facts": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "station://contracts/appcenter-v1/facts",
    "title": "AppCenterFacts",
    "type": "object",
    "properties": {
      "schemaVersion": {
        "const": 1
      },
      "requestId": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
      },
      "scope": {
        "$ref": "station://contracts/appcenter-v1/common#/$defs/scope"
      },
      "revision": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "generatedAt": {
        "type": "string",
        "format": "date-time",
        "pattern": "Z$"
      },
      "sources": {
        "type": "array",
        "items": {
          "$ref": "station://contracts/appcenter-v1/common#/$defs/source"
        },
        "maxItems": 6
      },
      "items": {
        "type": "array",
        "items": {
          "$ref": "station://contracts/appcenter-v1/common#/$defs/fact"
        },
        "maxItems": 1000
      }
    },
    "required": [
      "schemaVersion",
      "requestId",
      "scope",
      "revision",
      "generatedAt",
      "sources",
      "items"
    ],
    "additionalProperties": false
  },
  "station://contracts/appcenter-v1/legacy": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "station://contracts/appcenter-v1/legacy",
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schemaVersion",
      "revision",
      "records"
    ],
    "properties": {
      "schemaVersion": {
        "const": 1
      },
      "revision": {
        "type": "string",
        "pattern": "^sha256:[a-f0-9]{64}$"
      },
      "records": {
        "type": "array",
        "maxItems": 128,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bindingId",
            "appId",
            "organizationId",
            "stationId",
            "observationKey",
            "workloadUID",
            "adapterId",
            "backendRevision",
            "route"
          ],
          "properties": {
            "bindingId": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,127}$"
            },
            "appId": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
            },
            "organizationId": {
              "type": "string",
              "format": "uuid"
            },
            "stationId": {
              "type": "string",
              "format": "uuid"
            },
            "observationKey": {
              "type": "string",
              "pattern": "^obs:[a-f0-9]{64}$"
            },
            "workloadUID": {
              "type": "string",
              "format": "uuid"
            },
            "adapterId": {
              "enum": [
                "image-iframe-v1",
                "video-iframe-v1",
                "blender-host-v1"
              ]
            },
            "backendRevision": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "route": {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^/market\\?"
            }
          }
        }
      }
    }
  },
  "station://contracts/v1/app-catalog-item": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "station://contracts/v1/app-catalog-item",
    "title": "AppCatalogItem",
    "type": "object",
    "required": [
      "app_id",
      "display_name",
      "group_id",
      "brand",
      "models",
      "source",
      "namespace",
      "workload_name",
      "version",
      "images",
      "model_status",
      "deployment"
    ],
    "properties": {
      "app_id": {
        "type": "string",
        "minLength": 1
      },
      "display_name": {
        "type": "string",
        "minLength": 1
      },
      "group_id": {
        "enum": [
          "image",
          "music",
          "video",
          "system",
          "desktop",
          "blender"
        ]
      },
      "brand": {
        "enum": [
          "vf",
          "minimax",
          "github"
        ]
      },
      "models": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "source": {
        "type": "string",
        "minLength": 1
      },
      "namespace": {
        "type": "string",
        "minLength": 1
      },
      "workload_name": {
        "type": "string",
        "minLength": 1
      },
      "version": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
      },
      "images": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "component",
            "image"
          ],
          "properties": {
            "component": {
              "type": "string",
              "minLength": 1
            },
            "image": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "minItems": 1
      },
      "model_status": {
        "enum": [
          "unknown",
          "not_required"
        ]
      },
      "deployment": {
        "type": "object",
        "required": [
          "state",
          "reason",
          "observed_at",
          "desired_replicas",
          "ready_replicas",
          "images"
        ],
        "properties": {
          "state": {
            "enum": [
              "unknown",
              "not_installed",
              "stopped",
              "stopping",
              "starting",
              "ready",
              "degraded"
            ]
          },
          "reason": {
            "enum": [
              "unavailable",
              "forbidden",
              "invalid_response",
              "not_found",
              "reconciling",
              "scaling_down",
              "scaled_to_zero",
              "deployment_failed",
              "replicas_ready"
            ]
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "desired_replicas": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "ready_replicas": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "images": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "component",
                "image"
              ],
              "properties": {
                "component": {
                  "type": "string",
                  "minLength": 1
                },
                "image": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "uid": {
            "type": "string",
            "format": "uuid"
          },
          "management_status": {
            "enum": [
              "unknown",
              "unmanaged",
              "managed",
              "foreign"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  },
  "station://contracts/v1/app-command": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "station://contracts/v1/app-command",
    "title": "AppCommand",
    "type": "object",
    "required": [
      "request_id",
      "idempotency_key",
      "organization_id",
      "station_id",
      "app_id",
      "app_version",
      "action"
    ],
    "properties": {
      "request_id": {
        "type": "string",
        "minLength": 1
      },
      "idempotency_key": {
        "type": "string",
        "minLength": 8,
        "maxLength": 128
      },
      "organization_id": {
        "type": "string",
        "format": "uuid"
      },
      "station_id": {
        "type": "string",
        "format": "uuid"
      },
      "app_id": {
        "type": "string",
        "minLength": 1
      },
      "app_version": {
        "type": "string",
        "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
      },
      "action": {
        "enum": [
          "install",
          "start",
          "stop",
          "restart",
          "delete",
          "adopt"
        ]
      },
      "expected_workload_uid": {
        "type": "string",
        "format": "uuid"
      }
    },
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "properties": {
            "action": {
              "const": "adopt"
            }
          }
        },
        "then": {
          "required": [
            "expected_workload_uid"
          ]
        },
        "else": {
          "not": {
            "required": [
              "expected_workload_uid"
            ]
          }
        }
      }
    ]
  }
}
